{
  "name": "sneaks-api",
  "version": "1.2.1",
  "description": "A RESTful API that collects and returns data on sneakers. This API will also find, compare and return a link of where to buy the sneaker based on the price.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "test:live": "node --import tsx scripts/smoke.ts",
    "start": "node build/server.js",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/druv5319/Sneaks-API.git"
  },
  "keywords": [
    "sneakers",
    "shoes",
    "goat",
    "stadium goods",
    "flight club",
    "stockx",
    "restful",
    "api",
    "nodejs"
  ],
  "author": "druv5319@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/druv5319/Sneaks-API/issues"
  },
  "homepage": "https://github.com/druv5319/Sneaks-API#readme",
  "dependencies": {
    "@types/express": "^5.0.6",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "got": "^16.1.0",
    "mongoose": "^9.11.2",
    "playwright-core": "^1.64.1",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/node": "^22.20.5",
    "nock": "^15.0.2",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
